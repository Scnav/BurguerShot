:root {
  color-scheme: dark;
  --bg: #0b1120;
  --card: #111827;
  --card-hover: #172033;
  --border: #243244;
  --primary: #f97316;
  --success: #22c55e;
  --danger: #ef4444;
  --text: #f8fafc;
  --muted: #94a3b8;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(circle at top, #0f274f, #0b1120 50%);
  color: var(--text);
  font-family: Inter, Segoe UI, sans-serif;
  padding: 24px;
}

button,
input,
select {
  font: inherit;
  min-height: 42px;
}

/* Hero */
.hero {
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: 20px;
  backdrop-filter: blur(12px);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  padding: 24px;
  margin-bottom: 16px;
  position: relative;
}

.hero span {
  color: var(--primary);
  font-weight: 800;
  font-size: 13px;
  text-transform: uppercase;
}

.hero h1 {
  margin: 6px 0 0;
  font-size: 26px;
}

.hero p {
  margin: 6px 0 0;
  color: var(--muted);
}

/* Stats */
.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin: 20px 0;
}

.stat-card {
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: 20px;
  backdrop-filter: blur(12px);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  padding: 24px;
  position: relative;
}

.stat-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.08), transparent);
  pointer-events: none;
  border-radius: inherit;
}

.stat-card h3 {
  margin: 0 0 8px;
  font-size: 13px;
  color: var(--muted);
  font-weight: 700;
  text-transform: uppercase;
}

.stat-card span {
  font-size: 24px;
  font-weight: 800;
}

/* Cards */
.card {
  background: rgba(17, 24, 39, 0.75);
  backdrop-filter: blur(12px);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  transition: 0.25s;
  position: relative;
}

.card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.08), transparent);
  pointer-events: none;
  border-radius: inherit;
}

.card:hover {
  transform: translateY(-4px);
  border-color: rgba(255, 255, 255, 0.06);
}

/* Control */
.control-panel {
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: 20px;
  backdrop-filter: blur(12px);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  padding: 18px;
  margin-bottom: 16px;
}

.skin-form {
  display: grid;
  grid-template-columns: minmax(220px, 1.4fr) minmax(180px, 1fr) minmax(150px, 0.8fr) minmax(150px, 0.8fr) auto;
  gap: 12px;
  align-items: end;
}

label {
  display: grid;
  gap: 7px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

input,
select {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 12px;
  height: 50px;
  padding: 0 12px;
  background: #0b1220;
  color: var(--text);
}

input:focus,
select:focus {
  outline: 2px solid rgba(249, 115, 22, 0.45);
  outline-offset: 1px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 14px;
}

button {
  border: 0;
  border-radius: 12px;
  padding: 0 18px;
  color: #fff;
  cursor: pointer;
  font-weight: 600;
  transition: transform 0.2s ease, filter 0.2s ease;
}

button:hover {
  transform: translateY(-2px);
}

button:active {
  transform: translateY(0);
}

.btn-primary {
  background: var(--primary);
}

.btn-success {
  background: var(--success);
}

.btn-danger {
  background: var(--danger);
  border: 1px solid transparent;
}

.btn-dark {
  background: #1e293b;
}

button.secondary {
  background: var(--panel-strong);
  color: var(--text);
  border: 1px solid var(--border);
}

button.secondary:hover {
  border-color: var(--muted);
}

button.ghost {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
  font-weight: 600;
  border-radius: 10px;
  padding: 8px 12px;
}

button.ghost:hover {
  border-color: var(--muted);
  background: rgba(255, 255, 255, 0.03);
}

button.ghost.small {
  padding: 4px 10px;
  font-size: 11px;
}

/* Layout */
.main-content {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 24px;
}

.table-panel,
.alerts-panel {
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: 20px;
  backdrop-filter: blur(12px);
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  min-height: 420px;
  position: relative;
}

.table-panel::before,
.alerts-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.08), transparent);
  pointer-events: none;
  border-radius: inherit;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 18px;
  border-bottom: 1px solid var(--border);
}

.section-header span {
  color: var(--muted);
  font-size: 13px;
}

/* Skin cards */
.cards-grid {
  display: grid;
  gap: 16px;
  padding: 16px;
}

.skin-card {
  display: grid;
  grid-template-columns: 100px 1fr auto;
  gap: 16px;
  align-items: center;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(17, 24, 39, 0.55);
  transition: 0.25s;
}

.skin-card:hover {
  transform: translateY(-4px);
  background: var(--card-hover);
  border-color: rgba(255, 255, 255, 0.08);
}

.skin-card img {
  width: 80px;
  height: 80px;
  object-fit: contain;
  border-radius: 14px;
  background: var(--panel-strong, #1e293b);
  border: 1px solid var(--border);
}

.skin-info h3 {
  margin: 0 0 4px;
  font-size: 14px;
  font-weight: 700;
}

.skin-info small {
  color: var(--muted);
  font-size: 11px;
}

.skin-price {
  font-size: 22px;
  font-weight: 800;
  margin-top: 4px;
  display: block;
}

.skin-spark {
  display: block;
  margin-top: 8px;
}

.skin-meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-top: 4px;
}

.skin-meta span {
  font-size: 12px;
  color: var(--muted);
}

.positive {
  color: var(--success);
}

.negative {
  color: var(--danger);
}

/* Alerts */
.alerts-list {
  display: grid;
  gap: 10px;
  padding: 14px;
}

.alert-item {
  border: 1px solid rgba(239, 68, 68, 0.45);
  background: rgba(239, 68, 68, 0.09);
  border-radius: 12px;
  padding: 12px;
}

.alert-item strong {
  display: block;
  margin-bottom: 6px;
  font-size: 13px;
}

.alert-item span {
  color: var(--muted);
  font-size: 12px;
}

.alert-badge {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  border-radius: 999px;
  padding: 0 10px;
  font-size: 12px;
  font-weight: 800;
  background: var(--panel-strong);
  color: var(--muted);
  margin-top: 6px;
}

.alert-badge.drop {
  background: rgba(239, 68, 68, 0.18);
  color: var(--danger);
}

.alert-badge.rise {
  background: rgba(34, 197, 94, 0.18);
  color: var(--success);
}

.empty-alerts {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 34px 12px;
  text-align: center;
  color: var(--muted);
}

.empty-icon {
  font-size: 36px;
  line-height: 1;
}

.empty-alerts h3 {
  margin: 0;
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}

.empty-alerts p {
  margin: 0;
  font-size: 12px;
}

/* Modal */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.8);
  animation: fadeIn 0.2s ease-in;
}

.modal.active {
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 20px;
  max-width: 900px;
  width: 90%;
  max-height: 85vh;
  overflow-y: auto;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

.modal-header h2 {
  margin: 0;
  font-size: 20px;
}

.modal-button {
  background: transparent;
  border: none;
  color: var(--muted);
  cursor: pointer;
  padding: 0;
  min-height: auto;
  min-width: auto;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  margin-right: 8px;
}

.modal-button:hover {
  color: var(--text);
  background: var(--card-hover);
}

.close-button {
  background: transparent;
  border: none;
  color: var(--muted);
  font-size: 28px;
  cursor: pointer;
  padding: 0;
  min-height: auto;
  min-width: auto;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
}

.close-button:hover {
  color: var(--text);
  background: var(--card-hover);
}

.modal-body {
  padding: 20px;
}

#priceChart {
  margin-bottom: 20px;
  max-height: 400px;
}

.chart-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
  margin-top: 20px;
}

.stat-box {
  background: var(--card-hover);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 12px;
  color: var(--muted);
  text-transform: uppercase;
  font-weight: 700;
  margin-bottom: 6px;
}

.stat-value {
  display: block;
  font-size: 16px;
  color: var(--primary);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.stat-value.positive {
  color: var(--success);
}

.stat-value.negative {
  color: var(--danger);
}

/* Utilities */
.muted {
  color: var(--muted);
  font-size: 13px;
}

.badge {
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  border-radius: 999px;
  padding: 0 10px;
  font-size: 12px;
  font-weight: 800;
  background: var(--card-hover);
  color: var(--muted);
}

.empty-state {
  margin: 0;
  padding: 12px;
  color: var(--muted);
  font-size: 13px;
}

@media (max-width: 920px) {
  .skin-form,
  .main-content {
    grid-template-columns: 1fr;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 900px) {
  .main-content {
    grid-template-columns: 1fr;
  }

  .stats {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 560px) {
  .app-shell {
    width: min(100% - 20px, 1180px);
    padding: 14px 0;
  }

  h1 {
    font-size: 23px;
  }

  .actions button,
  .skin-form button {
    width: 100%;
  }
}
