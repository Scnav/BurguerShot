# Configuração do Rust Skin Watch

## Servidor Backend
BACKEND_PORT=3000
BACKEND_HOST=localhost

## Frontend
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080

## Steam Market
STEAM_APP_ID=252490
STEAM_CURRENCY=5
STEAM_COUNTRY=BR
STEAM_MARKET_URL=https://steamcommunity.com/market/priceoverview/

## Timeouts
REQUEST_TIMEOUT_MS=10000
SLEEP_DELAY_MS=650

## Limites
MAX_ALERTS=30
MIN_INTERVAL_SECONDS=5
MAX_INTERVAL_SECONDS=60
